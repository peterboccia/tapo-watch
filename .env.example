# Copy to .env in your working directory. Never commit your real credentials.
# Existing process environment variables override .env values.
TAPO_CAMERA_HOST=

# Local Camera Account configured in the Tapo app for ONVIF/RTSP.
TAPO_CAMERA_USERNAME=
TAPO_CAMERA_PASSWORD=

# Privacy control only: camera or admin.
# admin uses the literal username "admin" and the owner's cloud password.
TAPO_CAMERA_AUTH=camera
TAPO_CAMERA_ADMIN_PASSWORD=

# Telegram motion alerts: photo (default) or video (3-second silent MP4).
# Foto/snapshot/watch always remain JPEG.
TAPO_CAMERA_MOTION_MEDIA=photo

# BotFather token and comma-separated positive numeric Telegram USER IDs.
# Not usernames, phone numbers, or negative group IDs.
TAPO_TELEGRAM_BOT_TOKEN=
TAPO_TELEGRAM_USER_IDS=
